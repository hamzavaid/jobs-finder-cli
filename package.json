{
  "name": "jobs-finder-cli",
  "version": "2.0.0",
  "private": true,
  "description": "Occupation-neutral job search with automatic public ATS discovery and caching",
  "type": "module",
  "bin": {
    "jobs": "./bin/jobs.js"
  },
  "scripts": {
    "start": "node ./bin/jobs.js",
    "test": "node --test",
    "lint": "node scripts/check-syntax.js",
    "test:live": "node scripts/live-smoke.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:cache": "node scripts/cache-performance.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "commander": "13.1.0",
    "robots-parser": "3.0.1"
  },
  "license": "MIT"
}
